# Perfect Corp API Configuration V1
CLIENT_ID=
CLIENT_SECRET=

# Perfect Corp API Key V2 (untuk API v2.0)
API_KEY_V2=

# API URLs V1
TOKEN_URL=https://yce-api-01.perfectcorp.com/s2s/v1.0/client/auth
UPLOAD_URL=https://yce-api-01.perfectcorp.com/s2s/v1.1/file/skin-analysis
ANALYSIS_URL=https://yce-api-01.perfectcorp.com/s2s/v1.0/task/skin-analysis

# API URLs V2
UPLOAD_URL_V2=https://yce-api-01.perfectcorp.com/s2s/v2.0/file/skin-analysis
ANALYSIS_URL_V2=https://yce-api-01.perfectcorp.com/s2s/v2.0/task/skin-analysis

# Server Configuration
HOST=0.0.0.0
PORT=8000

# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skin_analysis

# Dataset Storage Configuration
# DATASET_DIR=/path/to/dataset  # Optional, default: ./dataset

# CORS Configuration (optional)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# File Upload Configuration (optional)
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png
MAX_FILE_SIZE=10485760